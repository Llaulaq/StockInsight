/* ГЛАВНОЕ ОКНО */
QMainWindow {
    background-color: #f5f5f5;
}

/* ТЕКСТОВЫЕ МЕТКИ */
QLabel {
    color: #333333;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 14px;
    font-weight: 500;
}

/* КНОПКИ */
QPushButton {
    background-color: #e0e0e0;
    color: #333333;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #999999;
}

/* ПОЛЯ ВВОДА */
QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #0078d7;
}

QLineEdit::placeholder {
    color: #aaaaaa;
}

/* ВЫПАДАЮЩИЙ СПИСОК */
QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid #0078d7;
}

QComboBox::drop-down {
    border: none;
    width: 0px;
}

QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    image: none;
}

/* ТАБЛИЦА */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #e0e0e0;
    border: none;
    border-radius: 8px;
    outline: none;
}

QTableWidget::item {
    background-color: transparent;          
}

QTableWidget::item:selected {
    background-color: #d0d0d0;
    color: #333333;
}

QTableWidget::item:alternate {
    background-color: #f0f0f0;
}

/* ЗАГОЛОВКИ ТАБЛИЦЫ */
QTableWidget QHeaderView {
    background-color: #e8e8e8;
}

QTableWidget QHeaderView::section {
    background-color: #e8e8e8;
    color: #333333;
    font-weight: bold;
    padding: 8px 12px;
    border: none;
    font-size: 13px;
}

/* Угловая кнопка */
QTableCornerButton::section {
    background-color: #e8e8e8;
    border: none;
}

/* ВКЛАДКИ ДЛЯ ГРАФИКОВ */
QTabWidget::pane {
    background-color: #ffffff;
    border: none;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #e8e8e8;
    color: #666666;
    padding: 8px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #333333;
}

QTabBar::tab:hover {
    background-color: #d0d0d0;
    color: #333333;
}

/* РАЗДЕЛИТЕЛЬ */
QSplitter::handle {
    background-color: #cccccc;
    height: 4px;
    border-radius: 2px;
}

/* СООБЩЕНИЯ (QMessageBox) */
QMessageBox {
    background-color: #f5f5f5;
    color: #333333;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    background-color: #e0e0e0;
    color: #333333;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
}

QMessageBox QPushButton:hover {
    background-color: #d0d0d0;
}